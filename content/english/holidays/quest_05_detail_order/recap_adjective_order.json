  "sections": [
    {
      "type": "bullets",
      "title": "The Adjective Order Rule",
      "points": [
        "When using multiple adjectives, there is a specific order:",
        "1. Opinion (beautiful, ugly, nice, lovely)",
        "2. Size (big, small, tall, short)",
        "3. Age (old, new, young, ancient)",
        "4. Color (red, blue, yellow, green)",
        "5. Material (wooden, metal, plastic, silk)",
        "Example: A beautiful big old red wooden table"
      ]
    },
    {
      "type": "bullets",
      "title": "Common Examples",
      "points": [
        "✗ Wrong: red beautiful flowers",
        "✓ Correct: beautiful red flowers",
        "✗ Wrong: wooden small table",
        "✓ Correct: small wooden table",
        "✗ Wrong: new tall blue building",
        "✓ Correct: tall new blue building"
      ]
    },
    {
      "type": "warning",
      "text": "Tip: Most native speakers place color after size and before material!"
    }
  ]
}
